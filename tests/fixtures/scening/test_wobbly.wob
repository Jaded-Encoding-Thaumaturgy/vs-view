    {
      "contents": "import os, sys\nanchor_dirname = f'{os.sep}S01'\nstats = []\nfields = clip#.std.Crop(right=clip.width-80)\nfields = fields.std.SeparateFields(tff=True).std.PlaneStats()\nfor field in fields[40517*2:40564*2].frames(close=True):\n    stats.append(field.props['PlaneStatsAverage'])\nwith open(os.path.join(sys.path[-1][:sys.path[-1].rindex(anchor_dirname)+len(anchor_dirname)], 'stats.log'), 'w') as file:\n    file.write('{' + ','.join(f'{{{i}/2,{x}}}' for i, x in enumerate(stats, 40517*2)) + '}')",
      "name": "dump"
    },
    {
      "contents": "clip = clip.std.Expr(['x 16 - 40 * 16 +', 'x 128 - 40 * 128 +'][:clip.format.num_planes])",
      "name": "exaggerate_black"
    },
    {
      "contents": "clip = clip.std.Expr(['x 235 - 40 * 235 +', 'x 128 - 40 * 128 +'][:clip.format.num_planes])",
      "name": "exaggerate_white"
    },
    {
      "contents": "# NB: the fade starts two frames earlier,\n# in the preceding section, which has a different telecine pattern.\n# By using nc/dk matches and *not* smoothing those two frames,\n# we ensure an overall smoother end result:\n# the fade parameter goes 0.5, then 3.5, then 6.5 + 2.5n,\n# so the steps are 3, 3, 2.5, 2.5, 2.5...\n\nfrom crossfades import smooth_stable_fade\nclip = smooth_stable_fade(clip, 45388, 45400, 3)",
      "name": "fade_45388"
    },
    {
      "contents": "from crossfades import smooth_stable_fade\nclip = smooth_stable_fade(clip, 45789, 45803, 2)",
      "name": "fade_45789"
    },
    {
      "contents": "from vsdenoise import mpeg2stinx\nfrom vstools import vs\nclip = (mpeg2stinx(clip.std.SetFieldBased(vs.FIELD_PROGRESSIVE))\n    .std.SetFieldBased(vs.FIELD_TOP))",
      "name": "mpeg2stinx"
    },
    {
      "contents": "import os, sys\nanchor_dirname = f'{os.sep}S01'\nsys.path.insert(0, sys.path[-1][:sys.path[-1].rindex(anchor_dirname)+len(anchor_dirname)])\nfrom filterchain.presets import deinterlace\ndel sys.path[0]\n\nclip = clip[:1415] + clip[1376] + clip[1416:]\nclip = deinterlace(clip)[1::2]",
