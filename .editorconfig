# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,ts,tsx,css,mts,mjs,cjs,cts}]
indent_size = 2
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.html]
indent_size = 2

[*.json]
indent_size = 2
